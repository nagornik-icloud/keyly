    "polish.afterStop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is rewritten once you stop recording — what appeared while you spoke gets replaced by the processed version. A separate AI request on the selected key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст будет переписан после остановки записи — то, что появлялось по ходу речи, заменится обработанным. Отдельный запрос к AI по выбранному ключу."
          }
        }
      }
    },
    "polish.cloudAlways": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing runs in the cloud on the selected key — even when the local model does the recognition. The text is sent, not the recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка идёт в облаке по выбранному ключу — даже когда распознаёт локальная модель. В облако уходит текст, не запись."
          }
        }
      }
    },
    "polish.extraRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate AI request on the selected key, on top of the recognition."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный запрос к AI по выбранному ключу — сверх распознавания."
          }
        }
      }
    },
