    "backup.import.tooNew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was made by a newer Keyly (schema %lld, this version understands %lld). Update the app — otherwise some settings would be lost silently."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сделан более новой версией Keyly (схема %lld, эта версия понимает %lld). Обнови приложение — иначе часть настроек потерялась бы молча."
          }
        }
      }
    },
    "backup.import.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the file — it does not look like a Keyly file, or it is damaged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл — похоже, он не от Keyly или повреждён."
          }
        }
      }
    },
