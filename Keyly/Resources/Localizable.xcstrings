{
  "sourceLanguage": "ru",
  "strings": {
    "": {},
    "%lld": {
      "comment": "A small, numbered badge that indicates the order of a step in a multi-step process. The argument is the step number.",
      "isCommentAutoGenerated": true
    },
    "%lld %%": {
      "comment": "Ширина 11 пикселей — ширина цифры «1» в шрифте 11 пикселей.",
      "isCommentAutoGenerated": true
    },
    "Keyly": {
      "comment": "The name of the app.",
      "isCommentAutoGenerated": true
    },
    "about.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart hotkeys for text, dictation and launching your favourite apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умные хоткеи для текста, диктовки и запуска любимых приложений."
          }
        }
      }
    },
    "apiKeys.missing.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI features work only through an OpenAI or Gemini key — it can be added in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-функции работают только через ключ OpenAI или Gemini — его можно добавить в Настройках."
          }
        }
      }
    },
    "apiKeys.missing.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки"
          }
        }
      }
    },
    "apiKeys.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key needed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен API-ключ"
          }
        }
      }
    },
    "apiKeys.saveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyly couldn't write to the macOS Keychain, so this key will be lost after a restart. Restarting Keyly and allowing Keychain access when macOS asks fixes this."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyly не смогла записать ключ в связку ключей macOS, и после перезапуска он пропадёт. Поможет перезапуск Keyly и разрешение доступа к связке ключей, когда система его запросит."
          }
        }
      }
    },
    "apiKeys.saveFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the API key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить API-ключ"
          }
        }
      }
    },
    "backup.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export to file"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгрузить в файл"
          }
        }
      }
    },
    "backup.exportLog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export log"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгрузить лог"
          }
        }
      }
    },
    "backup.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets, modules, hotkeys and launch targets. API keys are NEVER included: the file ends up in cloud storage and in email, and a key is a payment instrument."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сниппеты, модули, хоткеи и цели запуска. Ключи API в файл НЕ попадают: файл кладут в облако и пересылают почтой, а ключ — платёжный инструмент."
          }
        }
      }
    },
    "backup.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from file"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить из файла"
          }
        }
      }
    },
    "backup.import.backupFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyly couldn't save a copy of the current settings, so nothing was replaced. Free up disk space and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyly не смогла сохранить копию текущих настроек, поэтому ничего не заменено. Поможет освободить место на диске и повторить импорт."
          }
        }
      }
    },
    "backup.import.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace all settings?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить все настройки?"
          }
        }
      }
    },
    "backup.import.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file brings %lld snippets, %lld modules and %lld launch targets. Your current ones will be REPLACED, not merged. The previous state is saved to a backup — you can revert right after the import."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из файла придут %lld сниппетов, %lld модулей и %lld целей запуска. Текущие будут ЗАМЕНЕНЫ, а не объединены. Прежнее состояние сохранится в резервную копию — откатить можно будет сразу после импорта."
          }
        }
      }
    },
    "backup.import.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings replaced"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки заменены"
          }
        }
      }
    },
    "backup.import.done.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Module links to API keys were cleared — pick a key again on each module screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязки модулей к ключам API сброшены — ключ назначается заново на экране каждого модуля."
          }
        }
      }
    },
    "backup.import.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File rejected"
          }
        },
